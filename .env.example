# Copia este archivo como .env (NO lo subas a GitHub).
DJANGO_SECRET_KEY=cambia-esto-por-una-clave-larga-y-aleatoria
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=tu-app.up.railway.app
DJANGO_CSRF_TRUSTED_ORIGINS=https://tu-app.up.railway.app
DATABASE_URL=postgres://usuario:clave@host:5432/kino

# Google Drive, opción 1 (recomendada): contenido de drive-token.json generado con `manage.py drive_login`
GOOGLE_OAUTH_TOKEN_JSON=
# Google Drive, opción 2: cuenta de servicio (bloqueada hoy por la política de la organización)
GOOGLE_SERVICE_ACCOUNT_JSON=
DRIVE_INVENTORY_FOLDER_ID=
DRIVE_PHOTOS_FOLDER_ID=

# Umbrales (propuestas iniciales)
KINO_MAX_MISSING_SKU_PCT=5
KINO_MAX_SOLD_OUT_PCT=15
KINO_STALE_INVENTORY_HOURS=24

# Google Fotos: assisted (manual) hasta el GO del piloto; luego playwright
KINO_PHOTOS_EXECUTOR=assisted
KINO_PHOTOS_DRY_RUN=1
